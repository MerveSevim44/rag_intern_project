+# Türetme/oluşturma NİYETİ: "nasıl oluşturulmuş", "hangi kurala göre", "kuralını göster" gibi.
+_DERIVATION_INTENT = [
+    r"(nas[ıi]l|hangi)\s+(bir\s+)?kural",
+    r"kural(a|ı|ını|ini)?\s+(g[öo]re|g[öo]ster)",
+    r"nas[ıi]l\s+(olu[şs]turul|t[üu]retil|[üu]retil|olu[şs]mu[şs])",
+]
+
+
+def _named_columns(question: str, df: pd.DataFrame) -> list:
+    """Sorunun ADIYLA andığı df sütunları (tam sözcük eşleşmesi, büyük/küçük harf duyarsız)."""
+    q = question.strip().lower()
+    return [str(c) for c in df.columns
+            if re.search(rf"(?<![\w.]){re.escape(str(c).lower())}(?![\w])", q)]
+
+
+def _build_named_column_recipe(question: str, df: pd.DataFrame) -> str:
+    """
+    İKİ koşul birlikte sağlanınca ipucu enjekte eder, aksi hâlde boş string döner
+    (prompt değişmez): (a) soru şemadaki en az bir sütunu adıyla anıyor VE (b) soru bir
+    türetme/oluşturma kuralı soruyor (backlog #45: model `slug` sütunu hazır dururken
+    kendi uydurma türetme fonksiyonunu yazıp yanlış değer üretiyordu).
+    """
+    q = question.strip().lower()
+    if not any(re.search(p, q) for p in _DERIVATION_INTENT):
+        return ""
+    cols = _named_columns(question, df)
+    if not cols:
+        return ""
+    listed = ", ".join(f"'{c}'" for c in cols)
+    return f"""
+
+ZORUNLU YÖNTEM - TÜRETME KURALI SORUSU:
+Soru {listed} sütun(lar)ını adıyla anıyor ve bunların nasıl oluşturulduğunu soruyor. Bu sütunların
+değerleri veride HAZIR duruyor. Kendi türetme fonksiyonunu YAZMA; gerçek değerleri bir örnek satırdan oku:
+    row = df[<soruda adı geçen kişi/kod koşulu varsa o koşul, yoksa df.index == df.index[0]>].iloc[0]
+    result = row[[{listed}]].to_dict()   # sorudaki diğer ilgili sütunları da ekle
+Sonuç, GERÇEK sütun değerlerini içermeli; kod 'result = ...' atamasıyla bitmeli."""
+
+
